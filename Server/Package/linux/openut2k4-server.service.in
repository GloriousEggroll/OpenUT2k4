# OpenUT2k4 dedicated server: systemd unit template. Server/linux/install-service.sh fills in the @...@ values;
# see Server/Docs/DedicatedServer.md "Linux (systemd)".
[Unit]
Description=OpenUT2k4 dedicated server (@NAME@)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
@USERLINE@
WorkingDirectory=@STATE@
ExecStart="@ROOT@/openut2k4-server" "-ServerConfig=@CONFIG@" "-ServerStateDir=@STATE@" "-userdir=@STATE@" "-abslog=@LOGDIR@/OpenUT2k4Server.log"@EXTRA@
# stdin is /dev/null: admin commands go through the TCP admin console ([OpenUT2k4.AdminConsole])
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openut2k4-server-@NAME@
# graceful stop: SIGTERM; the server tells its players and flushes its log
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=30
# restart after a crash or a failed match; 2 (bad configuration) and 3 (no content) need the admin first
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2 3
SuccessExitStatus=130 143
# an unprivileged service: no new privileges, private /tmp, read-only system folders
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
@HARDENING@

[Install]
WantedBy=@WANTEDBY@
