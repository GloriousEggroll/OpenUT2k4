# Build output, caches and local data (see also Client/.gitignore)
Binaries/
Intermediate/
Saved/
Saved_*/
DerivedDataCache/
Dist/
__pycache__/
*.pyc

# Never commit UT2004 data or anything converted from it
Content/Imported/
Content/ImportedData/
ImportCache/
*.ut2
*.utx
*.usx
*.ukx
*.uax
*.uz2

# OpenUT2k4 Validator: the compiled mutator is a build artifact (Server/Validator/build-validator.sh)
Server/Validator/Build/
*.u
# Keys never go into the repository (Server/Docs/Validator.md): release / ban list signing keys, player keys
*.key
signing/
PlayerKey.txt
*.minisig
