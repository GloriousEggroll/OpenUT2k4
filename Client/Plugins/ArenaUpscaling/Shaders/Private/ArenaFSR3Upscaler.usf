#include "/Plugin/ArenaUpscaling/Private/FidelityFX/fsr3upscaler/ffx_fsr3upscaler_reproject.ush"
#include "/Plugin/ArenaUpscaling/Private/FidelityFX/fsr3upscaler/ffx_fsr3upscaler_accumulate.ush"

[numthreads(8, 8, 1)]
void MainCS(int2 iDispatchThreadId : SV_DispatchThreadID)
{
	Accumulate(iDispatchThreadId);
}

#elif ARENA_FSR3_PASS == ARENA_FSR3_PASS_RCAS

#define FSR3UPSCALER_BIND_SRV_INPUT_EXPOSURE            0
#define FSR3UPSCALER_BIND_SRV_RCAS_INPUT                1
#define FSR3UPSCALER_BIND_UAV_UPSCALED_OUTPUT           0
