#include "/Plugin/ArenaUpscaling/Private/FidelityFX/fsr3upscaler/ffx_fsr3upscaler_rcas.ush"

[numthreads(64, 1, 1)]
void MainCS(uint3 LocalThreadId : SV_GroupThreadID, uint3 WorkGroupId : SV_GroupID, uint3 Dtid : SV_DispatchThreadID)
{
	RCAS(LocalThreadId, WorkGroupId, Dtid);
}

#endif
